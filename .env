# ===========================================================
# Frontend Environment Variables — NamBộSpecialties
# ===========================================================

# URL backend Laravel (KHÔNG có dấu / ở cuối)
# Local development:
VITE_BACKEND_URL=http://127.0.0.1:8000

# Production (Render):
# VITE_BACKEND_URL=https://lvtnbackend.onrender.com

# URL API (dùng bởi axiosClient)
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api

# Production:
# VITE_API_URL=https://lvtnbackend.onrender.com/api
